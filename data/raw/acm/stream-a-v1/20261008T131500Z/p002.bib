@inproceedings{10.1145/3482632.3487527,
author = {Zhang, Pengwei},
title = {There is No Need for Trusted Third Party Data Aggregation Schemes for Privacy Protection in the Grid},
year = {2021},
isbn = {9781450390255},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3482632.3487527},
doi = {10.1145/3482632.3487527},
abstract = {The location privacy of users is very important in V2G network, but users are easy to expose their location when sharing data. In this paper, data privacy and location privacy of users in smart grid communication and V2G network communication are studied. Based on traditional data aggregation and data sharing schemes, a series of solutions are proposed in terms of functionality, security and performance cost},
booktitle = {2021 4th International Conference on Information Systems and Computer Aided Education},
